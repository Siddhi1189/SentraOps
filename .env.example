# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentraops?schema=public"

# Redis Configuration (Used by BullMQ and Pub/Sub)
REDIS_URL="redis://localhost:6379"

# Server Port
PORT=4000

# Client Configuration
CLIENT_ORIGIN="http://localhost:3000"

# JWT Secret Keys (Generate secure random keys in production)
JWT_ACCESS_SECRET="default_access_token_secret_key_12345"
JWT_REFRESH_SECRET="default_refresh_token_secret_key_67890"

# SMTP Configuration (For email notifications)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user"
SMTP_PASS="smtp_pass"
SMTP_FROM="noreply@sentraops.com"
