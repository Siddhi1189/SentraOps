# Demo Shop Port (Default: 4050)
PORT=4050

# SentraOps DSN format: https://<apiKey>@<backendHost>/<projectId>
# Replace with the real API key and Project ID generated in SentraOps Projects Settings
SENTRAOPS_DSN=https://sops_demo_key_example@localhost:4000/00000000-0000-0000-0000-000000000001

# Configurable delay in milliseconds for GET /api/slow (Default: 2500)
SLOW_DELAY_MS=2500

# Environment and Release identifiers
NODE_ENV=production
RELEASE=demo-shop@1.0.0
