datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  owner
  admin
  viewer
}

enum HttpMethod {
  GET
  POST
  HEAD
  PUT
}

enum PriorityLevel {
  low
  medium
  high
  critical
}

enum ServiceStatus {
  up
  down
  degraded
  maintenance
  unknown
}

enum HealthStatus {
  up
  down
  timeout
}

enum IncidentStatus {
  open
  investigating
  identified
  monitoring
  resolved
}

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum MaintenanceStatus {
  scheduled
  in_progress
  completed
}

enum NotificationChannel {
  email
  slack
  discord
  webhook
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum TimelineEventType {
  health_check_failed
  failure_count_increased
  incident_created
  status_changed
  assigned
  comment_added
  resolved
  notification_sent
}

enum EnvironmentType {
  production
  staging
}

model Organization {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @db.VarChar(255)
  slug                String               @unique @db.VarChar(100)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  users               User[]
  serviceGroups       ServiceGroup[]
  services            Service[]
  tags                Tag[]
  incidents           Incident[]
  maintenanceWindows  MaintenanceWindow[]
  escalationPolicies  EscalationPolicy[]
  notifications       Notification[]
  statusPageSettings  StatusPageSettings?
  auditLogs           AuditLog[]
  inviteTokens        InviteToken[]

  @@map("organizations")
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String         @db.VarChar(255)
  email          String         @unique @db.VarChar(255)
  passwordHash   String         @map("password_hash")
  role           UserRole       @default(viewer)
  isActive       Boolean        @default(true) @map("is_active")
  failedLoginAttempts Int     @default(0) @map("failed_login_attempts")
  lockedUntil    DateTime?      @map("locked_until") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  incidents      Incident[]
  auditLogs      AuditLog[]

  @@index([organizationId], map: "idx_users_organization_id")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@index([tokenHash], map: "idx_password_reset_tokens_token_hash")
  @@map("password_reset_tokens")
}

model InviteToken {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String       @db.VarChar(255)
  role           UserRole     @default(viewer)
  tokenHash      String       @map("token_hash")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime?    @map("accepted_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_invite_tokens_org_id")
  @@index([tokenHash], map: "idx_invite_tokens_token_hash")
  @@map("invite_tokens")
}

model ServiceGroup {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  parentGroupId  String?        @map("parent_group_id") @db.Uuid
  name           String         @db.VarChar(255)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentGroup    ServiceGroup?  @relation("GroupHierarchy", fields: [parentGroupId], references: [id], onDelete: SetNull)
  childGroups    ServiceGroup[] @relation("GroupHierarchy")
  services       Service[]

  @@index([organizationId], map: "idx_service_groups_org")
  @@map("service_groups")
}

model Service {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  groupId               String?             @map("group_id") @db.Uuid
  name                  String              @db.VarChar(255)
  url                   String
  httpMethod            HttpMethod          @default(GET) @map("http_method")
  expectedStatusCode    Int                 @default(200) @map("expected_status_code")
  timeoutMs             Int                 @default(5000) @map("timeout_ms")
  checkIntervalSeconds  Int                 @default(60) @map("check_interval_seconds")
  environment           EnvironmentType     @default(production) @map("environment")
  priority              PriorityLevel       @default(medium) @map("priority")
  currentStatus         ServiceStatus       @default(unknown) @map("current_status")
  consecutiveFailures   Int                 @default(0) @map("consecutive_failures")
  isActive              Boolean             @default(true) @map("is_active")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group                 ServiceGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  serviceTags           ServiceTag[]
  healthChecks          HealthCheck[]
  incidents             Incident[]
  maintenanceWindows    MaintenanceWindow[]
  escalationPolicies    EscalationPolicy[]

  @@index([organizationId], map: "idx_services_organization_id")
  @@index([groupId], map: "idx_services_group_id")
  @@index([currentStatus], map: "idx_services_current_status")
  @@index([createdAt(sort: Desc)], map: "idx_services_created_at")
  @@map("services")
}

model Tag {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(100)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceTags    ServiceTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model ServiceTag {
  serviceId String  @map("service_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serviceId, tagId])
  @@map("service_tags")
}

model HealthCheck {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId      String       @map("service_id") @db.Uuid
  status         HealthStatus
  httpStatusCode Int?         @map("http_status_code")
  responseTimeMs Int?         @map("response_time_ms")
  errorMessage   String?      @map("error_message")
  checkedAt      DateTime     @default(now()) @map("checked_at") @db.Timestamptz
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, checkedAt(sort: Desc)], map: "idx_health_checks_service_time")
  @@map("health_checks")
}

model Incident {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  serviceId      String           @map("service_id") @db.Uuid
  assignedUserId String?          @map("assigned_user_id") @db.Uuid
  title          String           @db.VarChar(255)
  status         IncidentStatus   @default(open)
  severity       IncidentSeverity @default(medium)
  rootCause      String?          @map("root_cause")
  resolutionNotes String?         @map("resolution_notes")
  detectedAt     DateTime         @default(now()) @map("detected_at") @db.Timestamptz
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assignedUser   User?            @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  timelineEvents TimelineEvent[]
  notifications  Notification[]

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_incidents_org_created")
  @@index([serviceId], map: "idx_incidents_service_id")
  @@index([status], map: "idx_incidents_status")
  @@index([detectedAt(sort: Desc)], map: "idx_incidents_detected_at")
  @@map("incidents")
}

model TimelineEvent {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId  String            @map("incident_id") @db.Uuid
  eventType   TimelineEventType @map("event_type")
  description String
  metadata    Json?             @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  incident    Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt(sort: Asc)], map: "idx_timeline_events_incident_id")
  @@map("timeline_events")
}

model MaintenanceWindow {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  serviceId      String?           @map("service_id") @db.Uuid
  title          String            @db.VarChar(255)
  description    String?
  startTime      DateTime          @map("start_time") @db.Timestamptz
  endTime        DateTime          @map("end_time") @db.Timestamptz
  status         MaintenanceStatus @default(scheduled)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service?          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@index([organizationId], map: "idx_maintenance_org_id")
  @@index([status], map: "idx_maintenance_status")
  @@index([serviceId, startTime], map: "idx_maintenance_service_time")
  @@map("maintenance_windows")
}

model EscalationPolicy {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  serviceId         String?      @map("service_id") @db.Uuid
  warningThreshold  Int          @default(3) @map("warning_threshold")
  incidentThreshold Int          @default(5) @map("incident_threshold")
  criticalThreshold Int          @default(10) @map("critical_threshold")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service           Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, serviceId])
  @@map("escalation_policies")
}

model Notification {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  incidentId     String?             @map("incident_id") @db.Uuid
  maintenanceId  String?             @map("maintenance_id") @db.Uuid
  channel        NotificationChannel
  recipient      String              @db.VarChar(255)
  status         NotificationStatus  @default(pending)
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident       Incident?           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  maintenance    MaintenanceWindow?  @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_notifications_org_id")
  @@index([status], map: "idx_notifications_status")
  @@map("notifications")
}

model StatusPageSettings {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @unique @map("organization_id") @db.Uuid
  subdomain      String       @unique @db.VarChar(100)
  customDomain   String?      @map("custom_domain") @db.VarChar(255)
  logoUrl        String?      @map("logo_url")
  theme          String       @default("light") @db.VarChar(50)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("status_page_settings")
}

model AuditLog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  action         String       @db.VarChar(100)
  entityType     String       @map("entity_type") @db.VarChar(100)
  entityId       String?      @map("entity_id") @db.Uuid
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_audit_logs_org_id")
  @@map("audit_logs")
}
