datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  owner
  admin
  viewer
}

enum HttpMethod {
  GET
  POST
  HEAD
  PUT
}

enum PriorityLevel {
  low
  medium
  high
  critical
}

enum ServiceStatus {
  up
  down
  degraded
  maintenance
  unknown
}

enum HealthStatus {
  up
  down
  timeout
}

enum MonitorType {
  http
  heartbeat
}

enum IncidentStatus {
  open
  investigating
  identified
  monitoring
  resolved
}

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum MaintenanceStatus {
  scheduled
  in_progress
  completed
}

enum NotificationChannel {
  email
  slack
  discord
  webhook
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum TimelineEventType {
  health_check_failed
  failure_count_increased
  incident_created
  status_changed
  assigned
  comment_added
  resolved
  notification_sent
}

enum EnvironmentType {
  production
  staging
}

enum PlatformType {
  node
  browser
  other
}

enum ErrorLevel {
  error
  warning
  info
}

enum IssueStatus {
  unresolved
  resolved
  ignored
}

model Organization {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @db.VarChar(255)
  slug                String               @unique @db.VarChar(100)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  users               User[]
  serviceGroups       ServiceGroup[]
  services            Service[]
  tags                Tag[]
  incidents           Incident[]
  maintenanceWindows  MaintenanceWindow[]
  escalationPolicies  EscalationPolicy[]
  notifications       Notification[]
  statusPageSettings  StatusPageSettings?
  auditLogs           AuditLog[]
  inviteTokens        InviteToken[]
  projects            Project[]
  issues              Issue[]
  alertChannels       AlertChannel[]
  alertRules          AlertRule[]

  @@map("organizations")
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String         @db.VarChar(255)
  email          String         @unique @db.VarChar(255)
  passwordHash   String         @map("password_hash")
  role           UserRole       @default(viewer)
  isActive       Boolean        @default(true) @map("is_active")
  failedLoginAttempts Int     @default(0) @map("failed_login_attempts")
  lockedUntil    DateTime?      @map("locked_until") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  incidents      Incident[]
  acknowledgedIncidents Incident[]          @relation("AcknowledgedIncidents")
  auditLogs      AuditLog[]
  notificationReads NotificationRead[]
  assignedIssues Issue[]              @relation("AssignedIssues")

  @@index([organizationId], map: "idx_users_organization_id")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@index([tokenHash], map: "idx_password_reset_tokens_token_hash")
  @@map("password_reset_tokens")
}

model InviteToken {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String       @db.VarChar(255)
  role           UserRole     @default(viewer)
  tokenHash      String       @map("token_hash")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime?    @map("accepted_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_invite_tokens_org_id")
  @@index([tokenHash], map: "idx_invite_tokens_token_hash")
  @@map("invite_tokens")
}

model ServiceGroup {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  parentGroupId  String?        @map("parent_group_id") @db.Uuid
  name           String         @db.VarChar(255)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentGroup    ServiceGroup?  @relation("GroupHierarchy", fields: [parentGroupId], references: [id], onDelete: SetNull)
  childGroups    ServiceGroup[] @relation("GroupHierarchy")
  services       Service[]

  @@index([organizationId], map: "idx_service_groups_org")
  @@map("service_groups")
}

model Service {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  groupId               String?             @map("group_id") @db.Uuid
  name                  String              @db.VarChar(255)
  url                   String?
  monitorType           MonitorType         @default(http) @map("monitor_type")
  httpMethod            HttpMethod          @default(GET) @map("http_method")
  expectedStatusCode    Int                 @default(200) @map("expected_status_code")
  timeoutMs             Int                 @default(5000) @map("timeout_ms")
  checkIntervalSeconds  Int                 @default(60) @map("check_interval_seconds")
  requestHeaders        Json?               @map("request_headers")
  requestBody           String?             @map("request_body") @db.Text
  assertions            Json?               @default("[]")
  heartbeatToken        String?             @unique @map("heartbeat_token") @db.VarChar(64)
  heartbeatIntervalSeconds Int?             @map("heartbeat_interval_seconds")
  heartbeatGraceSeconds Int?                @map("heartbeat_grace_seconds")
  lastHeartbeatAt       DateTime?           @map("last_heartbeat_at") @db.Timestamptz
  environment           EnvironmentType     @default(production) @map("environment")
  priority              PriorityLevel       @default(medium) @map("priority")
  currentStatus         ServiceStatus       @default(unknown) @map("current_status")
  consecutiveFailures   Int                 @default(0) @map("consecutive_failures")
  isActive              Boolean             @default(true) @map("is_active")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group                 ServiceGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  serviceTags           ServiceTag[]
  healthChecks          HealthCheck[]
  incidents             Incident[]
  maintenanceWindows    MaintenanceWindow[]
  escalationPolicies    EscalationPolicy[]
  alertRules            AlertRule[]

  @@index([organizationId], map: "idx_services_organization_id")
  @@index([groupId], map: "idx_services_group_id")
  @@index([currentStatus], map: "idx_services_current_status")
  @@index([createdAt(sort: Desc)], map: "idx_services_created_at")
  @@index([heartbeatToken], map: "idx_services_heartbeat_token")
  @@map("services")
}

model Tag {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(100)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceTags    ServiceTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model ServiceTag {
  serviceId String  @map("service_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serviceId, tagId])
  @@map("service_tags")
}

model HealthCheck {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId         String       @map("service_id") @db.Uuid
  status            HealthStatus
  httpStatusCode    Int?         @map("http_status_code")
  responseTimeMs    Int?         @map("response_time_ms")
  sslDaysRemaining  Int?         @map("ssl_days_remaining")
  failedAssertion   Json?        @map("failed_assertion")
  errorMessage      String?      @map("error_message")
  checkedAt         DateTime     @default(now()) @map("checked_at") @db.Timestamptz
  service           Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, checkedAt(sort: Desc)], map: "idx_health_checks_service_time")
  @@map("health_checks")
}

model Incident {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  serviceId      String           @map("service_id") @db.Uuid
  assignedUserId        String?          @map("assigned_user_id") @db.Uuid
  acknowledgedAt        DateTime?        @map("acknowledged_at") @db.Timestamptz
  acknowledgedByUserId  String?          @map("acknowledged_by_user_id") @db.Uuid
  title                 String           @db.VarChar(255)
  status                IncidentStatus   @default(open)
  severity              IncidentSeverity @default(medium)
  rootCause             String?          @map("root_cause")
  resolutionNotes       String?          @map("resolution_notes")
  detectedAt            DateTime         @default(now()) @map("detected_at") @db.Timestamptz
  resolvedAt            DateTime?        @map("resolved_at") @db.Timestamptz
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service               Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assignedUser          User?            @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  acknowledgedByUser    User?            @relation("AcknowledgedIncidents", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  timelineEvents        TimelineEvent[]
  issues         Issue[]          @relation("LinkedIssues")
  notifications  Notification[]

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_incidents_org_created")
  @@index([serviceId], map: "idx_incidents_service_id")
  @@index([status], map: "idx_incidents_status")
  @@index([detectedAt(sort: Desc)], map: "idx_incidents_detected_at")
  @@map("incidents")
}

model TimelineEvent {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId  String            @map("incident_id") @db.Uuid
  eventType   TimelineEventType @map("event_type")
  description String
  metadata    Json?             @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  incident    Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt(sort: Asc)], map: "idx_timeline_events_incident_id")
  @@map("timeline_events")
}

model MaintenanceWindow {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  serviceId      String?           @map("service_id") @db.Uuid
  title          String            @db.VarChar(255)
  description    String?
  startTime      DateTime          @map("start_time") @db.Timestamptz
  endTime        DateTime          @map("end_time") @db.Timestamptz
  status         MaintenanceStatus @default(scheduled)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service?          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@index([organizationId], map: "idx_maintenance_org_id")
  @@index([status], map: "idx_maintenance_status")
  @@index([serviceId, startTime], map: "idx_maintenance_service_time")
  @@map("maintenance_windows")
}

model EscalationPolicy {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  serviceId         String?      @map("service_id") @db.Uuid
  warningThreshold  Int          @default(3) @map("warning_threshold")
  incidentThreshold Int          @default(5) @map("incident_threshold")
  criticalThreshold Int          @default(10) @map("critical_threshold")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service           Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, serviceId])
  @@map("escalation_policies")
}

model Notification {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  incidentId     String?             @map("incident_id") @db.Uuid
  maintenanceId  String?             @map("maintenance_id") @db.Uuid
  channel        NotificationChannel
  recipient      String              @db.VarChar(255)
  status         NotificationStatus  @default(pending)
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident       Incident?           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  maintenance    MaintenanceWindow?  @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  notificationReads NotificationRead[]

  @@index([organizationId], map: "idx_notifications_org_id")
  @@index([status], map: "idx_notifications_status")
  @@map("notifications")
}

model StatusPageSettings {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @unique @map("organization_id") @db.Uuid
  subdomain      String       @unique @db.VarChar(100)
  customDomain   String?      @map("custom_domain") @db.VarChar(255)
  logoUrl        String?      @map("logo_url")
  theme          String       @default("light") @db.VarChar(50)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("status_page_settings")
}

model AuditLog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  action         String       @db.VarChar(100)
  entityType     String       @map("entity_type") @db.VarChar(100)
  entityId       String?      @map("entity_id") @db.Uuid
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_audit_logs_org_id")
  @@map("audit_logs")
}

model NotificationRead {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  readAt         DateTime     @default(now()) @map("read_at") @db.Timestamptz
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId], map: "idx_notification_reads_user_id")
  @@map("notification_reads")
}

model Project {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  name               String          @db.VarChar(255)
  platform           PlatformType    @default(node)
  environmentDefault EnvironmentType @default(production) @map("environment_default")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys            ApiKey[]
  errorEvents        ErrorEvent[]
  issues             Issue[]
  alertRules         AlertRule[]

  @@unique([organizationId, name])
  @@index([organizationId], map: "idx_projects_org_id")
  @@map("projects")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  name       String    @db.VarChar(255)
  keyPrefix  String    @map("key_prefix") @db.VarChar(16)
  keyHash    String    @unique @map("key_hash") @db.VarChar(64)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([keyHash], map: "idx_api_keys_key_hash")
  @@index([projectId], map: "idx_api_keys_project_id")
  @@map("api_keys")
}

model Issue {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String       @map("project_id") @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  fingerprint       String       @db.VarChar(64)
  title             String       @db.VarChar(255)
  type              String       @db.VarChar(100)
  level             ErrorLevel   @default(error)
  status            IssueStatus  @default(unresolved)
  environment       String       @default("production") @db.VarChar(50)
  firstSeenAt       DateTime     @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt        DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz
  eventCount        Int          @default(1) @map("event_count")
  userCount         Int          @default(0) @map("user_count")
  assignedUserId    String?      @map("assigned_user_id") @db.Uuid
  resolvedAt        DateTime?    @map("resolved_at") @db.Timestamptz
  resolvedInRelease String?      @map("resolved_in_release") @db.VarChar(100)
  isRegression      Boolean      @default(false) @map("is_regression")
  linkedIncidentId  String?      @map("linked_incident_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser      User?        @relation("AssignedIssues", fields: [assignedUserId], references: [id], onDelete: SetNull)
  linkedIncident    Incident?    @relation("LinkedIssues", fields: [linkedIncidentId], references: [id], onDelete: SetNull)
  errorEvents       ErrorEvent[]

  @@unique([projectId, fingerprint, environment])
  @@index([organizationId, status, lastSeenAt(sort: Desc)], map: "idx_issues_org_status_last_seen")
  @@index([projectId], map: "idx_issues_project_id")
  @@map("issues")
}

model ErrorEvent {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  issueId     String?    @map("issue_id") @db.Uuid
  type        String     @db.VarChar(100)
  message     String     @db.Text
  stack       String?    @db.Text
  environment String     @default("production") @db.VarChar(50)
  release     String?    @db.VarChar(100)
  level       ErrorLevel @default(error)
  tags        Json?      @default("{}")
  breadcrumbs Json?      @default("[]")
  user        Json?
  request     Json?
  occurredAt  DateTime   @default(now()) @map("occurred_at") @db.Timestamptz
  receivedAt  DateTime   @default(now()) @map("received_at") @db.Timestamptz
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue       Issue?     @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([projectId, occurredAt(sort: Desc)], map: "idx_error_events_project_occurred")
  @@index([issueId, occurredAt(sort: Desc)], map: "idx_error_events_issue_occurred")
  @@map("error_events")
}

enum AlertRuleTrigger {
  service_down_consecutive_failures
  new_issue_in_environment
  event_rate_threshold
  response_time_threshold
  ssl_expiration_warning
}

model AlertChannel {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  type           NotificationChannel
  name           String              @db.VarChar(255)
  config         Json                @default("{}")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules          AlertRule[]         @relation("AlertRuleChannels")

  @@index([organizationId], map: "idx_alert_channels_org_id")
  @@map("alert_channels")
}

model AlertRule {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  name            String           @db.VarChar(255)
  trigger         AlertRuleTrigger
  conditions      Json             @default("{}")
  serviceId       String?          @map("service_id") @db.Uuid
  projectId       String?          @map("project_id") @db.Uuid
  cooldownSeconds Int              @default(300) @map("cooldown_seconds")
  snoozedUntil    DateTime?        @map("snoozed_until") @db.Timestamptz
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service         Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channels        AlertChannel[]   @relation("AlertRuleChannels")
  fires           AlertRuleFire[]

  @@index([organizationId], map: "idx_alert_rules_org_id")
  @@index([serviceId], map: "idx_alert_rules_service_id")
  @@index([projectId], map: "idx_alert_rules_project_id")
  @@map("alert_rules")
}

model AlertRuleFire {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId    String    @map("rule_id") @db.Uuid
  firedAt   DateTime  @default(now()) @map("fired_at") @db.Timestamptz
  context   Json?     @default("{}")
  rule      AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, firedAt(sort: Desc)], map: "idx_alert_rule_fires_rule_fired")
  @@map("alert_rule_fires")
