{
  "name": "sentraops",
  "version": "1.0.0",
  "description": "SentraOps backend platform for engineering operations monitoring, incident management, and status pages.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "worker": "nodemon worker/worker.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker\"",
    "start": "node src/index.js",
    "start:worker": "node worker/worker.js",
    "migrate": "npx prisma migrate dev --schema=src/models/schema.prisma",
    "generate": "npx prisma generate --schema=src/models/schema.prisma",
    "seed": "node src/seed/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "keywords": [
    "monitoring",
    "uptime",
    "incidents",
    "statuspage",
    "bullmq",
    "prisma",
    "socket.io"
  ],
  "author": "SentraOps Team",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^6.7.1",
    "@bull-board/express": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.61.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.22.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.1",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "winston": "^3.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0"
  }
}
