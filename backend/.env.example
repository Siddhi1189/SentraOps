# REQUIRED: PostgreSQL connection string (include ?schema=public)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?schema=public"

# REQUIRED: Redis connection string (used by BullMQ job queue and Pub/Sub event bridge)
REDIS_URL="redis://hostname:6379"

# OPTIONAL: HTTP port for the Express API server (defaults to 4000)
PORT=4000

# OPTIONAL: Runtime environment mode ('development', 'production', or 'test'; defaults to 'development')
NODE_ENV="production"

# OPTIONAL: Comma-separated list of allowed CORS web origins with no trailing slashes (defaults to http://localhost:3000)
CLIENT_ORIGIN="https://<your-vercel-app>.vercel.app"

# REQUIRED: Secret key for signing JWT access tokens (minimum 32 characters; rejects placeholders in production)
JWT_ACCESS_SECRET="<generate-32+-char-random-string>"

# REQUIRED: Secret key for signing JWT refresh tokens (minimum 32 characters; rejects placeholders in production)
JWT_REFRESH_SECRET="<generate-32+-char-random-string>"

# REQUIRED: SMTP server hostname for transactional email delivery
SMTP_HOST="smtp.mailtrap.io"

# OPTIONAL: SMTP server port (defaults to 587)
SMTP_PORT=587

# REQUIRED: SMTP username / auth credential
SMTP_USER="<smtp-username>"

# REQUIRED: SMTP password / auth credential
SMTP_PASS="<smtp-password>"

# OPTIONAL: Sender email address for outbound emails (defaults to noreply@sentraops.com)
SMTP_FROM="noreply@sentraops.com"

# OPTIONAL: Public frontend base URL used in notification emails and subscriber confirmation links (defaults to http://localhost:3000)
FRONTEND_URL="https://<your-vercel-app>.vercel.app"

# OPTIONAL: Anthropic API key for AI incident summary generation (leave empty if not using AI summaries)
ANTHROPIC_API_KEY=""

# OPTIONAL: Anthropic model identifier for AI incident summary (defaults to 'claude-sonnet-5-5')
ANTHROPIC_MODEL="claude-sonnet-5-5"

# OPTIONAL: Password assigned to seeded demo users during manual 'npm run seed' (defaults to 'ChangeMeInEnv!')
DEMO_SEED_PASSWORD="<demo-seed-password>"

# OPTIONAL: Base URL of the demo shop service monitored during manual 'npm run seed'
DEMO_APP_BASE_URL="http://localhost:4050"

# OPTIONAL: Worker data retention in days for historical health check logs (defaults to 30)
HEALTH_CHECK_RETENTION_DAYS=30

# OPTIONAL: Worker data retention in days for immutable audit logs (defaults to 90)
AUDIT_LOG_RETENTION_DAYS=90

# OPTIONAL: Worker data retention in days for error event ingest records (defaults to 30)
ERROR_EVENT_RETENTION_DAYS=30
