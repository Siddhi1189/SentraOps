# OPTIONAL: Base URL of the SentraOps backend REST API.
# Must include the '/api/v1' path prefix (e.g. https://<your-render-service>.onrender.com/api/v1)
# because the API client appends endpoint paths like '/auth/login' directly, while the
# Socket.IO client automatically derives the root origin from this URL.
# If omitted or left empty, the client defaults to '/api/v1' (suitable when Vercel rewrites/proxies /api to Render).
VITE_API_URL="https://<your-render-service>.onrender.com/api/v1"
